# Shared project defaults
APP_NAME=pasorapa-hato
APP_ENV=development

# API
API_PORT=8080
API_BASE_URL=http://localhost:8080

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hato
POSTGRES_USER=hato
POSTGRES_PASSWORD=hato_local_password

# Object storage
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hato-public
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_PUBLIC_BASE_URL=http://localhost:9000/hato-public
S3_PRESIGN_TTL_SECONDS=600
S3_MAX_UPLOAD_SIZE_BYTES=10485760
S3_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif

# Auth
JWT_ISSUER=pasorapa-hato
JWT_AUDIENCE=pasorapa-hato-clients
JWT_TTL_SECONDS=3600
