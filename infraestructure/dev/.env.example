# Desarrollo local solamente. NO reutilizar en producción.
COMPOSE_PROJECT_NAME=hato-dev

TZ=America/La_Paz

DEV_WEB_PORT=8080
DEV_API_PORT=8081
DEV_DB_PORT=5434

POSTGRES_DB=hato
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

QUARKUS_HTTP_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO
QUARKUS_LOG_FILE_ENABLED=true
QUARKUS_LOG_FILE_LEVEL=INFO
QUARKUS_LOG_FILE_PATH=/work/logs/hato-be.log
QUARKUS_LOG_CONSOLE_JSON_ENABLED=false
QUARKUS_LOG_FILE_JSON_ENABLED=false

AUTH_LEGACY_TOKEN_ENABLED=false

HATO_STORAGE_ANIMAL_IMAGES_ENABLED=true
# Host path persistente para imágenes del backend.
# Default recomendado: ../../images
# Se resuelve relativo a infraestructure/dev/docker-compose.yml cuando corrés docker compose directo.
# Ejemplo absoluto local: /Users/arturoherrera/Documents/proyectos/personal/pasorapa-hato/code/images
HATO_IMAGES_HOST_PATH=../../images
HATO_STORAGE_ANIMAL_IMAGES_ROOT_DIR=/work/storage/animal-images
HATO_STORAGE_ANIMAL_IMAGES_MAX_BYTES=2097152
HATO_STORAGE_ANIMAL_IMAGES_MIME_ALLOWLIST=image/jpeg,image/png

# Host path persistente para logs del backend.
# Default recomendado: ../../logs
# Se resuelve relativo a infraestructure/dev/docker-compose.yml cuando corrés docker compose directo.
# Ejemplo absoluto local: /Users/arturoherrera/Documents/proyectos/personal/pasorapa-hato/code/logs
HATO_LOGS_HOST_PATH=../../logs
